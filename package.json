{
  "name": "pi-ui-forge",
  "version": "0.1.0",
  "description": "tldraw-based UI mock forge for pi - agent-edited React mocks on a tldraw canvas in their own window, with a design-subagent control plane over pi-sock",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "build:editor": "vite build editor",
    "smoke": "node scripts/smoke-server.mjs",
    "check": "tsc -p editor/tsconfig.json && tsc --noEmit --strict --skipLibCheck --target ES2022 --module ESNext --moduleResolution bundler --types node --ignoreConfig index.ts"
  },
  "dependencies": {
    "electron": "^44.4.5",
    "esbuild": "^0.28.2",
    "html-to-image": "^1.11.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tldraw": "^5.4.2",
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron@44.4.5": true
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
